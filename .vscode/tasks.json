{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "[ESP] Get PC IP Address",
      "type": "shell",
      "command": "ipconfig | Select-String -Pattern 'IPv4' | Select-String -Pattern '192|172|10'",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "group": "test"
    },
    {
      "label": "[WHISPER] Build Example",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "SpeechToText/whisper",
        "-B",
        "SpeechToText/whisper/build",
        "-G",
        "Visual Studio 17 2022"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[WHISPER] Build Binaries",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "SpeechToText/whisper/build"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[WHISPER] Test Sample",
      "type": "shell",
      "command": "SpeechToText/whisper/build/bin/Debug/whisper-cli.exe",
      "args": [
        "-m",
        "SpeechToText/whisper/models/ggml-small.bin",
        "-f",
        "SpeechToText/whisper/samples/jfk.wav"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[WHISPER] Test API",
      "type": "shell",
      "command": "curl.exe",
      "args": [
        "-X",
        "POST",
        "http://localhost:8000/transcribe",
        "-F",
        "file=@SpeechToText/whisper/samples/jfk.wav"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[WHISPER] Rebuild and Restart API",
      "type": "shell",
      "command": "docker compose",
      "args": [
        "-f",
        "SpeechToText/whisper-api/docker-compose.yml",
        "up",
        "--build",
        "-d"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Install Dependencies Windows",
      "type": "shell",
      "command": "python -m pip install --upgrade pip setuptools wheel; python -m pip install numpy --upgrade; python -m pip install pkuseg==0.0.25; python -m pip install torch soundfile huggingface-hub safetensors; python -m pip install chatterbox-tts",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "[CHATTERBOX] Generate example",
      "type": "shell",
      "command": "py TextToSpeech/chatterbox/chatterbox_run_example.py",
      "args": [],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[CHATTERBOX] Generate voice from text",
      "type": "shell",
      "command": "py",
      "args": [
        "TextToSpeech/chatterbox/chatterbox_run.py",
        "--text",
        "Bonjour, je suis Margot le robot !",
        "--output",
        "demo_output.wav"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[CHATTERBOX] Launch container (NVIDIA)",
      "type": "shell",
      "command": "docker-compose",
      "args": [
        "-f",
        "TextToSpeech/Chatterbox-TTS-Server/docker-compose.yml",
        "up",
        "--build"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[CHATTERBOX] Init Submodule",
      "type": "shell",
      "command": "git",
      "args": [
        "submodule",
        "update",
        "--init",
        "--recursive"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[ESP] Erase Flash",
      "type": "shell",
      "command": "D:/Projets/Robot/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "esptool",
        "--port",
        "COM7",
        "erase-flash"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[LLM] Pull vLLM Images",
      "type": "shell",
      "command": "docker compose",
      "args": [
        "-f",
        "LLM/docker-compose.yml",
        "pull"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[LLM] Start vLLM Services",
      "type": "shell",
      "command": "docker compose",
      "args": [
        "-f",
        "LLM/docker-compose.yml",
        "up",
        "-d"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[LLM] Stop vLLM Services",
      "type": "shell",
      "command": "docker compose",
      "args": [
        "-f",
        "LLM/docker-compose.yml",
        "down"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[LLM] Test vLLM Health",
      "type": "shell",
      "command": "curl.exe",
      "args": [
        "-f",
        "http://localhost:8001/health"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[LLM] Test vLLM Models",
      "type": "shell",
      "command": "curl.exe",
      "args": [
        "-f",
        "http://localhost:8001/v1/models"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[LLM] Test vLLM Chat",
      "type": "shell",
      "command": "curl.exe",
      "args": [
        "-f",
        "-X",
        "POST",
        "http://localhost:8001/v1/chat/completions",
        "-H",
        "Content-Type: application/json",
        "-d",
        "{\"model\":\"robot-llm\",\"messages\":[{\"role\":\"user\",\"content\":\"Réponds en trois mots: bonjour robot\"}],\"max_tokens\":16,\"temperature\":0}"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    }
  ]
}