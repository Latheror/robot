{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "[ESP] Get PC IP Address",
      "type": "shell",
      "command": "ipconfig | Select-String -Pattern 'IPv4' | Select-String -Pattern '192|172|10'",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "group": "test"
    },
    {
      "label": "[WHISPER] Build Example",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "Backend/whisper.cpp",
        "-B",
        "Backend/whisper.cpp/build",
        "-G",
        "Visual Studio 17 2022"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[WHISPER] Build Binaries",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "Backend/whisper.cpp/build"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[WHISPER] Test Sample",
      "type": "shell",
      "command": "Backend/whisper.cpp/examples/main.exe",
      "args": [
        "-m",
        "Backend/whisper.cpp/models/ggml-base.en.bin",
        "-f",
        "Backend/whisper.cpp/samples/jfk.wav"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Install Dependencies Windows",
      "type": "shell",
      "command": "python -m pip install --upgrade pip setuptools wheel; python -m pip install numpy --upgrade; python -m pip install pkuseg==0.0.25; python -m pip install torch soundfile huggingface-hub safetensors; python -m pip install chatterbox-tts",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "[CHATTERBOX] Generate example",
      "type": "shell",
      "command": "py TextToSpeech/chatterbox/chatterbox_run_example.py",
      "args": [],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[CHATTERBOX] Generate voice from text",
      "type": "shell",
      "command": "py",
      "args": [
        "TextToSpeech/chatterbox/chatterbox_run.py",
        "--text",
        "Bonjour, je suis Margot le robot !",
        "--output",
        "demo_output.wav"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[CHATTERBOX] Launch container (NVIDIA)",
      "type": "shell",
      "command": "docker-compose",
      "args": [
        "-f",
        "TextToSpeech/Chatterbox-TTS-Server/docker-compose.yml",
        "up",
        "--build"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[CHATTERBOX] Init Submodule",
      "type": "shell",
      "command": "git",
      "args": [
        "submodule",
        "update",
        "--init",
        "--recursive"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[ESP] Erase Flash",
      "type": "shell",
      "command": "D:/Projets/Robot/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "esptool",
        "--port",
        "COM7",
        "erase-flash"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[LLM] Pull Images",
      "type": "shell",
      "command": "docker-compose",
      "args": [
        "-f",
        "LLM/docker-compose.yml",
        "pull"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[LLM] Start Services",
      "type": "shell",
      "command": "docker-compose",
      "args": [
        "-f",
        "LLM/docker-compose.yml",
        "up",
        "-d"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[LLM] Stop Services",
      "type": "shell",
      "command": "docker-compose",
      "args": [
        "-f",
        "LLM/docker-compose.yml",
        "down"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    }
  ]
}