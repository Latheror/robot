{
  "version": "2.0.0",
  "tasks": [
    {
  "label": "Build whisper.cpp example",
  "type": "shell",
  "command": "cmake",
  "args": ["-S", "Backend/whisper.cpp", "-B", "Backend/whisper.cpp/build", "-G", "Visual Studio 17 2022"],
      "group": "build",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Build whisper.cpp binaries",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "Backend/whisper.cpp/build"],
      "group": "build",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Test whisper.cpp sample",
      "type": "shell",
      "command": "Backend/whisper.cpp/examples/main.exe",
      "args": ["-m", "Backend/whisper.cpp/models/ggml-base.en.bin", "-f", "Backend/whisper.cpp/samples/jfk.wav"],
      "group": "test",
      "presentation": {
        "reveal": "always"
      }
    }
  ]
}
