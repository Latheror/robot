# vLLM model served through the OpenAI-compatible API.
# Default is close in size/capability to the previous llama3.2 local workflow model.
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_SERVED_MODEL_NAME=robot-llm
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEMORY_UTILIZATION=0.85
NVIDIA_VISIBLE_DEVICES=all

# Optional for gated/private Hugging Face models. Leave empty for public models.
HUGGING_FACE_HUB_TOKEN=

# Used by Open WebUI only; vLLM does not require a real key by default.
OPENAI_API_KEY=not-needed-local-vllm
