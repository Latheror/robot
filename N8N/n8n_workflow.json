        "jsCode": "// Get the raw message string\nconst rawMessage = $input.first().json.message;\n\n// Log for debugging\nconsole.log(\"rawMessage:\", rawMessage);\n\nif (!rawMessage) {\n  // If no message, return empty\n  return [];\n}\n\n// Parse the JSON string into an object\nlet mqttMessage;\ntry {\n  mqttMessage = JSON.parse(rawMessage);\n} catch (error) {\n  console.error(\"Failed to parse MQTT message:\", error);\n  return [];\n}\n\n// Retrieve sensor values\nconst sensors = mqttMessage.sensors;\nconst units = mqttMessage.units;\nconst topic = $input.first().json.topic;\n\n// Format the text for the LLM\nconst formattedText = `\nReceived data from topic \"${topic}\":\n- Temperature: ${sensors.temperature} ${units.temperature}\n- Humidity: ${sensors.humidity} ${units.humidity}\n- Light: ${sensors.light} ${units.light}\nTimestamp: ${mqttMessage.timestamp}\n\nPlease analyze this data and provide insights or alerts if necessary.\n`;\n\nreturn [\n  {\n    json: {\n      text: formattedText\n    }\n  }\n];\n"
      },
