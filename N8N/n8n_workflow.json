    {
      "parameters": {
        "jsCode": "const CHUNK_SIZE = 8000;\nconst itemsOut = [];\n\nfor (let itemIndex = 0; itemIndex < items.length; itemIndex++) {\n\n    const item = items[itemIndex];\n    if (!item.binary) continue;\n\n    const binaryKey = Object.keys(item.binary)[0];\n    if (!binaryKey) continue;\n\n    // Load real file buffer from filesystem storage\n    const buffer = await this.helpers.getBinaryDataBuffer(\n        itemIndex,\n        binaryKey\n    );\n\n    // Convert to Base64\n    const wavBase64 = buffer.toString('base64');\n\n    const totalChunks = Math.ceil(wavBase64.length / CHUNK_SIZE);\n\n    for (let i = 0; i < totalChunks; i++) {\n\n        const start = i * CHUNK_SIZE;\n        const end = start + CHUNK_SIZE;\n\n        itemsOut.push({\n            json: {\n                topic: \"robot/1/audio\",\n                chunk_index: i,\n                total_chunks: totalChunks,\n                message: wavBase64.slice(start, end)\n            }\n        });\n    }\n}\n\nreturn itemsOut;\n"
      },
