      "parameters": {
        "jsCode": "// n8n Function Node\n// input: $input.all() qui contient un tableau d'objets avec \"output\"\n\nreturn $input.all().map(item => {\n    const text = item.json.output;\n\n    // Supprime toutes les balises <think>...</think>\n    const withoutThink = text.replace(/<think>[\\s\\S]*?<\\/think>/g, '');\n\n    // Découpe en lignes, enlève les espaces et les lignes vides\n    const lines = withoutThink.split(/\\r?\\n/).map(l => l.trim()).filter(l => l.length > 0);\n\n    // Prend la dernière ligne comme réponse finale\n    const finalResponse = lines[lines.length - 1] || '';\n\n    return {\n        json: {\n            cleanedText: finalResponse\n        }\n    };\n});"
      },
