      "parameters": {
        "jsCode": "const CHUNK_SIZE = /*8000*/500; // ~8 KB per chunk, adjust if needed\nconst itemsOut = [];\n\n// Loop over all input items (from HTTP Request node)\nitems.forEach(item => {\n    const binaryItem = item.binary?.data;\n    if (!binaryItem) return;\n\n    // Convert WAV to Base64\n    const wavBase64 = binaryItem.data.toString('base64');\n\n    // Calculate number of chunks\n    const totalChunks = Math.ceil(wavBase64.length / CHUNK_SIZE);\n\n    for (let i = 0; i < totalChunks; i++) {\n        const start = i * CHUNK_SIZE;\n        const end = Math.min(start + CHUNK_SIZE, wavBase64.length);\n        const chunk = wavBase64.slice(start, end);\n\n        itemsOut.push({\n            json: {\n                topic: \"robot/1/audio\",\n                chunk_index: i,\n                total_chunks: totalChunks,\n                message: chunk\n            }\n        });\n    }\n});\n\nreturn itemsOut;\n"
      },
