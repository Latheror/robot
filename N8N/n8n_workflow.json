    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\n\n// initialisation\nif (!store.chunks) store.chunks = [];\nif (!store.lastUpdate) store.lastUpdate = 0;\n\nconst payload = JSON.parse($json.message);\n\nconst index = payload.chunk_index;\nconst total = payload.total_chunks;\nconst chunk = payload.message;\n\nlet message_start = false;\nconst now = Date.now();\n\n/* ----------------------------\n   RESET uniquement si nouveau fichier\n   ---------------------------- */\nif (index === 0) {\n  store.chunks = [];\n  message_start = true;\n}\n\n// ne jamais écraser un chunk déjà reçu\nif (store.chunks[index] === undefined) {\n  store.chunks[index] = chunk;\n}\n\nstore.lastUpdate = now;\n\n// compter correctement les chunks reçus\nconst received = store.chunks.reduce((a, v) => v !== undefined ? a + 1 : a, 0);\n\n// tableau des indexes présents\nconst present_indexes = Object.keys(store.chunks).map(i => parseInt(i));\n\n// détecter les chunks manquants\nconst missing = [];\nfor (let i = 0; i < total; i++) {\n  if (store.chunks[i] === undefined) missing.push(i);\n}\n\nconst allReceived = received === total;\n\n/* ----------------------------\n   DEBUG / Retour intermédiaire\n   ---------------------------- */\nif (!allReceived) {\n  return [{\n    json: {\n      message_start,\n      chunk_index: index,\n      chunks_numbers: total,\n      received_chunks: received,\n      present_indexes,\n      missing_chunks: missing,\n      all_chunks_received: false\n    }\n  }];\n}\n\n/* ----------------------------\n   Tous les chunks reçus → reconstruction\n   ---------------------------- */\nconst fullBase64 = store.chunks.join('');\n\n// reset pour le prochain fichier\nstore.chunks = [];\nstore.lastUpdate = 0;\n\nreturn [{\n  json: {\n    message_start,\n    chunk_index: index,\n    chunks_numbers: total,\n    received_chunks: received,\n    present_indexes,\n    missing_chunks: [],\n    all_chunks_received: true,\n    base64: fullBase64\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -224,
        -2432
      ],
      "id": "0591855b-ffad-417d-be78-42931a7f6891",
      "name": "Code7",
      "alwaysOutputData": false,
      "executeOnce": false
    },
    {
      "parameters": {
        "jsCode": "const missing_chunks = $input.first().json.missing_chunks;\n\n// si tous les chunks sont reçus et que le base64 existe\nif (missing_chunks.length === 0 && $input.first().json.base64 != null) {\n\n    const base64Data = $input.first().json.base64;\n\n    // convertir en Buffer\n    const buffer = Buffer.from(base64Data, 'base64');\n\n    return [{\n        binary: {\n            audio: {\n                data: buffer.toString('base64'), // stocké en base64 pour n8n\n                mimeType: 'audio/wav',\n                fileName: 'audio.wav'\n            }\n        },\n        json: {\n            message: 'WAV file ready',\n            chunks_numbers: $input.first().json.chunks_numbers,\n            received_chunks: $input.first().json.received_chunks\n        }\n    }];\n\n} else {\n    // chunks manquants, ne rien produire pour l'instant\n    return [];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        -2432
      ],
      "id": "068f00dd-6a77-43c4-9ef6-8ffa80c9fc1a",
      "name": "Code10",
      "alwaysOutputData": false,
      "executeOnce": false
    },
    {
      "parameters": {
        "jsCode": "const itemsOut = [];\n\nfor (let itemIndex = 0; itemIndex < items.length; itemIndex++) {\n    const item = items[itemIndex];\n    if (!item.binary) continue;\n\n    const binaryKey = Object.keys(item.binary)[0];\n    if (!binaryKey) continue;\n\n    const buffer = await this.helpers.getBinaryDataBuffer(itemIndex, binaryKey);\n\n    // --- WAV header ---\n    const audioFormat = buffer.readUInt16LE(20);\n    const numChannels = buffer.readUInt16LE(22);\n    const sampleRate = buffer.readUInt32LE(24);\n    const bitsPerSample = buffer.readUInt16LE(34);\n\n    if (audioFormat !== 1) throw new Error('Only PCM WAV supported');\n\n    const bytesPerSample = bitsPerSample / 8;\n    const dataOffset = 44;\n    const factor = 8; // amplification\n\n    // Simple one-pole high-pass filter (removes low-frequency noise)\n    const alpha = 0.99; // adjust between 0.8 - 0.99\n    let lastSample = 0;\n\n    for (let i = dataOffset; i < buffer.length; i += bytesPerSample) {\n        let sample;\n\n        if (bytesPerSample === 2) {\n            sample = buffer.readInt16LE(i);\n\n            // Amplify\n            sample = sample * factor;\n\n            // High-pass filter\n            sample = alpha * (lastSample + sample - lastSample);\n            lastSample = sample;\n\n            // Clamp\n            sample = Math.max(Math.min(sample, 32767), -32768);\n            buffer.writeInt16LE(sample, i);\n        }\n        else if (bytesPerSample === 1) {\n            sample = buffer.readUInt8(i);\n            sample = (sample - 128) * factor;\n            sample = alpha * (lastSample + sample - lastSample);\n            lastSample = sample;\n            sample = Math.max(Math.min(sample + 128, 255), 0);\n            buffer.writeUInt8(sample, i);\n        }\n    }\n\n    itemsOut.push({\n        binary: {\n            audio: {\n                data: buffer.toString('base64'),\n                mimeType: 'audio/wav',\n                fileName: 'audio_amplified_filtered.wav'\n            }\n        },\n        json: {\n            message: 'WAV amplified + filtered'\n        }\n    });\n}\n\nreturn itemsOut;"
      },
